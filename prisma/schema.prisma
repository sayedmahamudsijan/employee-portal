generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified DateTime?
  image         String?
  employeeId    String?    @unique
  role          Role       @default(EMPLOYEE)
  status        UserStatus @default(PENDING)
  department    String?
  jobTitle      String?
  managerId     String?
  manager       User?      @relation("ManagerRelation", fields: [managerId], references: [id])
  reports       User[]     @relation("ManagerRelation")
  joinedAt      DateTime?
  birthday      DateTime?
  phone         String?
  emergencyContact String?
  // D&I voluntary self-identification (always optional)
  gender        String?
  ethnicity     String?
  pronouns      String?
  location      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts      Account[]
  sessions      Session[]
  tasks         Task[]
  workLogs      WorkLog[]
  leaveRequests LeaveRequest[]
  leaveBalance  LeaveBalance?
  goals         Goal[]
  reviews       PerformanceReview[] @relation("ReviewSubject")
  givenReviews  PerformanceReview[] @relation("Reviewer")
  announcements Announcement[]
  notifications Notification[]
  documents     Document[]
  activityLogs  ActivityLog[]
  kudosGiven    Kudos[]    @relation("KudosFrom")
  kudosReceived Kudos[]    @relation("KudosTo")
  assetAssignments AssetAssignment[]
  onboarding    OnboardingChecklist?

  // New tier 1+2 features
  attendances   Attendance[]
  expenses      Expense[]
  approvedExpenses Expense[] @relation("ExpenseApprover")
  ledProjects   Project[]    @relation("ProjectLead")
  meetingsAsManager OneOnOne[] @relation("MeetingManager")
  meetingsAsReport  OneOnOne[] @relation("MeetingReport")
  okrs          OKR[]
  ticketsCreated Ticket[]    @relation("TicketCreator")
  ticketsAssigned Ticket[]   @relation("TicketAssignee")
  ticketComments TicketComment[]
  mentorshipsAsMentor   Mentorship[] @relation("MentorRelation")
  mentorshipsAsMentee   Mentorship[] @relation("MenteeRelation")
  careerProfile CareerProfile?
  compensation  Compensation[]
  approvedWorkLogs WorkLog[]    @relation("WorkLogApprover")

  // Presence & Teams
  lastSeenAt    DateTime?
  teamMembers   TeamMember[]
  teamMessages  TeamMessage[]
  createdTeams  Team[]        @relation("TeamCreator")

  customRoleId  String?
  customRole    CustomRole?   @relation("UserCustomRole", fields: [customRoleId], references: [id], onDelete: SetNull)

  // Invitation / first-login verification
  accessCode            String?   // bcrypt hash (preferred) OR legacy SHA-256 hex of one-time portal access code
  accessCodeUsed        Boolean   @default(true)  // false = freshly invited, must verify on first login
  accessCodeExpiresAt   DateTime? // null = no expiry; set by invitation flow (default 7 days)
  accessCodeAttempts    Int       @default(0)     // failed verification attempts since last reset
  accessCodeLockedUntil DateTime? // if set & in the future, verify-code is locked
  invitedBy             String?   // userId of admin/exec who sent the invitation
  invitedAt             DateTime?

  // Security / session lifecycle
  lastLoginAt        DateTime? // updated on successful sign-in
  lastLoginIp        String?   // last source IP (audit trail)
  sessionsValidFrom  DateTime? // sessions issued before this timestamp are treated as revoked
  deactivatedAt      DateTime? // when the user was deactivated (for audit)

  invitations    Invitation[] @relation("InvitationSender")
}

/// Append-only security audit log. One row per security-relevant event:
/// sign-ins, failed sign-ins, access-code attempts, invitations, role changes,
/// user activation/deactivation, session revocations, rate-limit hits, etc.
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?  // actor (or subject for failed-login attempts on existing users)
  email     String?  // captured for events where userId might be null (e.g. unknown-email login attempts)
  event     String   // see lib/security/audit.ts for the enum of event names
  severity  String   @default("info") // "info" | "warn" | "critical"
  ip        String?  // x-forwarded-for / x-real-ip
  userAgent String?  // truncated UA string (max 256 chars)
  metadata  Json?    // arbitrary structured context (no secrets)
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([severity, createdAt])
}

/// Sliding-window rate-limit buckets, keyed by "scope:identifier"
/// (e.g. "verify-code:userid:cmoz..." or "invite:ip:203.0.113.5").
/// Cleaned up lazily — old buckets are overwritten on next hit.
model RateLimit {
  id          String    @id @default(cuid())
  key         String    @unique
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime? // hard-lock until this timestamp (set by lockout policies)
  updatedAt   DateTime  @updatedAt

  @@index([key, windowStart])
  @@index([lockedUntil])
}

enum Role {
  INTERN
  EMPLOYEE
  MANAGER
  ADMIN
  CEO
  CMO
  CTO
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  note      String?
  addedBy   String
  createdAt DateTime @default(now())
}

model AccessRequest {
  id         String              @id @default(cuid())
  name       String
  email      String
  department String?
  reason     String?             @db.Text
  status     AccessRequestStatus @default(PENDING)
  reviewedBy String?             // user id of admin who reviewed
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([status, createdAt])
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Invitation {
  id          String           @id @default(cuid())
  name        String
  email       String
  position    String?          // job title / position
  role        Role             @default(EMPLOYEE)
  customRoleId String?
  employeeId  String           // assigned employee ID e.g. MBD-AA-1001
  status      InvitationStatus @default(PENDING)
  sentById    String
  sentBy      User             @relation("InvitationSender", fields: [sentById], references: [id])
  sentAt      DateTime         @default(now())
  revokedAt   DateTime?
  resendCount Int              @default(0)

  @@index([email])
  @@index([status, sentAt])
}

enum InvitationStatus {
  PENDING    // email sent, not yet accepted
  ACCEPTED   // employee has verified access code
  REVOKED    // admin revoked before acceptance
}

model FeatureAccess {
  id      String   @id @default(cuid())
  feature String   @unique
  roles   String[]
}

model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   @default("#6366f1")
  description String?
  createdAt   DateTime @default(now())
  createdBy   String
  users       User[]   @relation("UserCustomRole")
}

model Sprint {
  id        String       @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    SprintStatus @default(PLANNED)
  teamId    String?
  projectId String?
  project   Project?     @relation(fields: [projectId], references: [id])
  tasks     Task[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Task {
  id           String     @id @default(cuid())
  title        String
  description  String?    @db.Text
  status       TaskStatus @default(TODO)
  priority     Priority   @default(MEDIUM)
  estimatedHrs Float?
  loggedHrs    Float      @default(0)
  dueDate      DateTime?
  assigneeId   String
  assignee     User       @relation(fields: [assigneeId], references: [id])
  sprintId     String?
  sprint       Sprint?    @relation(fields: [sprintId], references: [id])
  blockedById  String?
  tags         String[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workLogs     WorkLog[]
  activityLogs ActivityLog[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkLogStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model WorkLog {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  taskId          String?
  task            Task?         @relation(fields: [taskId], references: [id])
  date            DateTime
  hours           Float
  description     String
  status          WorkLogStatus @default(DRAFT)
  approvedById    String?
  approvedBy      User?         @relation("WorkLogApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model LeaveRequest {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  days       Int
  reason     String?
  status     LeaveStatus @default(PENDING)
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveBalance {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
  casual Int    @default(12)
  sick   Int    @default(10)
  annual Int    @default(15)
  year   Int
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  title       String
  description String?    @db.Text
  progress    Int        @default(0)
  status      GoalStatus @default(IN_PROGRESS)
  dueDate     DateTime?
  quarter     String
  year        Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum GoalStatus {
  IN_PROGRESS
  COMPLETED
  MISSED
}

model PerformanceReview {
  id         String       @id @default(cuid())
  subjectId  String
  subject    User         @relation("ReviewSubject", fields: [subjectId], references: [id])
  reviewerId String
  reviewer   User         @relation("Reviewer", fields: [reviewerId], references: [id])
  cycleId    String?
  cycle      ReviewCycle? @relation(fields: [cycleId], references: [id])
  period     String
  ratings    Json
  comments   String?      @db.Text
  submitted  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model ReviewCycle {
  id        String              @id @default(cuid())
  name      String
  period    String
  deadline  DateTime
  isOpen    Boolean             @default(true)
  createdAt DateTime            @default(now())
  reviews   PerformanceReview[]
}

model Document {
  id         String   @id @default(cuid())
  title      String
  category   String
  fileUrl    String
  fileType   String?
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  action    String   // "Created" | "Updated" | "Approved" | "Rejected" | "Deleted" | "Submitted" | "Activated" | "Deactivated"
  entity    String?  // "WorkLog" | "Task" | "LeaveRequest" | "Goal" | "User" | "Team" | "Announcement" | etc.
  entityId  String?
  section   String?  // "Workspace" | "Growth" | "Company" | "Manage" | "Admin" | "Account"
  oldValue  Json?    // Previous field values (null if newly created)
  newValue  Json?    // New field values after change
  details   String?  // Human-readable summary
  createdAt DateTime @default(now())

  @@index([section, createdAt])
  @@index([userId, createdAt])
}

model PublicHoliday {
  id   String   @id @default(cuid())
  name String
  date DateTime
  year Int
}

// =========================================================================
// NEW: Admin power features
// =========================================================================

model CompanySettings {
  id                   String   @id @default("singleton")
  companyName          String   @default("Meta Build Dynamics")
  companyLogo          String?
  timezone             String   @default("Asia/Dhaka")
  workingHoursStart    String   @default("09:00")
  workingHoursEnd      String   @default("18:00")
  workingDays          Int[]    @default([1, 2, 3, 4, 5])
  defaultCasualLeave   Int      @default(12)
  defaultSickLeave     Int      @default(10)
  defaultAnnualLeave   Int      @default(15)
  fiscalYearStart      String   @default("01-01")
  currency             String   @default("BDT")
  emailFromName        String   @default("MBD Portal")
  primaryColor         String   @default("#3b82f6")
  // History retention: null = keep forever; positive int = auto-delete after N days (cron runs daily)
  historyRetentionDays Int?
  // Portal design overrides (JSON blob — see lib/portal-design.ts for shape)
  designConfig         Json?
  updatedAt            DateTime @updatedAt
  updatedBy            String?
}

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String? @unique
  description String?
  headId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Kudos {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("KudosFrom", fields: [fromId], references: [id])
  toId      String
  to        User     @relation("KudosTo", fields: [toId], references: [id])
  message   String   @db.Text
  category  String   @default("teamwork")
  emoji     String   @default("🌟")
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Asset {
  id           String   @id @default(cuid())
  assetTag     String   @unique
  name         String
  category     String
  serialNumber String?
  purchaseDate DateTime?
  purchaseCost Float?
  warrantyEnd  DateTime?
  status       AssetStatus @default(AVAILABLE)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments AssetAssignment[]
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  RETIRED
}

model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  notes      String?
}

model OnboardingTemplate {
  id        String   @id @default(cuid())
  name      String
  role      String?
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OnboardingChecklist {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  templateId  String?
  items       Json
  startedAt   DateTime @default(now())
  completedAt DateTime?
  updatedAt   DateTime @updatedAt
}

// =========================================================================
// ATTENDANCE — Clock in/out tracking
// =========================================================================
model Attendance {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  date        DateTime  @db.Date
  clockIn     DateTime
  clockOut    DateTime?
  durationMin Int?      // computed on clock-out
  workMode    WorkMode  @default(OFFICE)
  notes       String?
  isLate      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, date])
  @@index([date])
}

enum WorkMode {
  OFFICE
  REMOTE
  HYBRID
}

// =========================================================================
// EXPENSES — Reimbursements with approval flow
// =========================================================================
model Expense {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  category    String
  amount      Float
  currency    String        @default("BDT")
  expenseDate DateTime
  description String
  receiptUrl  String?
  status      ExpenseStatus @default(PENDING)
  approverId  String?
  approver    User?         @relation("ExpenseApprover", fields: [approverId], references: [id])
  approvedAt  DateTime?
  rejectionReason String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

// =========================================================================
// PROJECTS — Above-sprint grouping
// =========================================================================
model Project {
  id          String        @id @default(cuid())
  name        String
  code        String?       @unique
  description String?       @db.Text
  client      String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  currency    String        @default("BDT")
  leadId      String?
  lead        User?         @relation("ProjectLead", fields: [leadId], references: [id])
  color       String?       @default("#6366f1")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sprints     Sprint[]
  okrs        OKR[]
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

// =========================================================================
// 1:1 MEETINGS — Manager ↔ Report
// =========================================================================
model OneOnOne {
  id          String   @id @default(cuid())
  managerId   String
  manager     User     @relation("MeetingManager", fields: [managerId], references: [id])
  reportId    String
  report      User     @relation("MeetingReport", fields: [reportId], references: [id])
  scheduledAt DateTime
  durationMin Int      @default(30)
  agenda      String?  @db.Text
  managerNotes String? @db.Text
  reportNotes String?  @db.Text
  actionItems Json     @default("[]")
  status      MeetingStatus @default(SCHEDULED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([managerId, scheduledAt])
  @@index([reportId, scheduledAt])
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

// =========================================================================
// OKRs — Objectives & Key Results (more structured than Goals)
// =========================================================================
model OKR {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id])
  objective   String
  description String?     @db.Text
  quarter     String      // e.g. "Q1"
  year        Int
  status      OKRStatus   @default(ACTIVE)
  keyResults  Json        @default("[]")  // [{id, title, target, current, unit, progress}]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum OKRStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

// =========================================================================
// HELPDESK — IT/HR/Office tickets
// =========================================================================
model Ticket {
  id          String      @id @default(cuid())
  number      Int         @default(autoincrement())
  title       String
  description String      @db.Text
  category    String      // IT, HR, Office, Other
  priority    Priority    @default(MEDIUM)
  status      TicketStatus @default(OPEN)
  creatorId   String
  creator     User        @relation("TicketCreator", fields: [creatorId], references: [id])
  assigneeId  String?
  assignee    User?       @relation("TicketAssignee", fields: [assigneeId], references: [id])
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  comments    TicketComment[]
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  isInternal Boolean @default(false)  // hidden from creator if true
  createdAt DateTime @default(now())
}

// =========================================================================
// MENTORSHIP — Pairing mentors and mentees
// =========================================================================
model Mentorship {
  id        String           @id @default(cuid())
  mentorId  String
  mentor    User             @relation("MentorRelation", fields: [mentorId], references: [id])
  menteeId  String
  mentee    User             @relation("MenteeRelation", fields: [menteeId], references: [id])
  focusArea String?          // e.g. "Engineering leadership", "Product strategy"
  goals     String?          @db.Text
  status    MentorshipStatus @default(ACTIVE)
  startDate DateTime         @default(now())
  endDate   DateTime?
  notes     String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([mentorId, menteeId])
}

enum MentorshipStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// =========================================================================
// CAREER PATHING — Levels, paths, and current step
// =========================================================================
model CareerLevel {
  id          String   @id @default(cuid())
  track       String   // e.g. "Engineering", "Design", "Product"
  level       Int      // 1, 2, 3...
  title       String   // "Senior Engineer", "Staff Engineer"
  description String?  @db.Text
  expectations Json    @default("[]")
  minSalary   Float?
  maxSalary   Float?
  currency    String   @default("BDT")
  createdAt   DateTime @default(now())

  @@unique([track, level])
}

model CareerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  track           String?
  currentLevel    Int?
  targetLevel     Int?
  targetDate      DateTime?
  developmentPlan String?  @db.Text
  achievements    Json     @default("[]")
  updatedAt       DateTime @updatedAt
}

// =========================================================================
// COMPENSATION — Salary history (admin-only access)
// =========================================================================
model Compensation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  effectiveDate DateTime
  baseSalary  Float
  currency    String   @default("BDT")
  bonusAnnual Float?
  equityShares Int?
  reason      String?  // "Annual review", "Promotion", "Market adjustment"
  notes       String?  @db.Text
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([userId, effectiveDate])
}

// =========================================================================
// TEAMS — Group workspaces with chat
// =========================================================================
model Team {
  id          String        @id @default(cuid())
  name        String
  description String?
  link        String?
  emoji       String?       @default("👥")
  createdById String
  createdBy   User          @relation("TeamCreator", fields: [createdById], references: [id])
  members     TeamMember[]
  messages    TeamMessage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  role     String   @default("MEMBER")   // OWNER | MEMBER
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
}

model TeamMessage {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  type      String   @default("TEXT")   // TEXT | STATUS
  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
}
